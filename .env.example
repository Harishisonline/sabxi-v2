# ============================================================================
# SABXI — Environment variables
# ============================================================================
# Copy this file to `.env.local` (gitignored) and fill in the values.
# For Vercel deployment: set these in Project Settings → Environment Variables.
# ============================================================================

# ----------------------------------------------------------------------------
# Clerk — authentication
# ----------------------------------------------------------------------------
# Get these from https://dashboard.clerk.com → your app → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Sign-in / sign-up paths (already wired in middleware).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ----------------------------------------------------------------------------
# Vercel KV (or Upstash Redis) — database for reviews, blogs, user mirror
# ----------------------------------------------------------------------------
# DEPRECATED: Vercel KV has been deprecated. Use Upstash Redis from the
# Vercel Marketplace instead: https://vercel.com/marketplace?category=storage&search=redis
# When you install Upstash, these 3 env vars are auto-populated.
#
# If you still want to use Vercel KV (works, deprecated):
#   1. Vercel Dashboard → your project → Storage → Create Database → KV
#   2. Click the database → .env.local tab → Copy Snippet
#
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ----------------------------------------------------------------------------
# Vercel Blob — image storage for blog covers and inline images
# ----------------------------------------------------------------------------
# 1. Vercel Dashboard → your project → Storage → Create Database → Blob
# 2. Click the blob store → .env.local tab → copy BLOB_READ_WRITE_TOKEN
#
BLOB_READ_WRITE_TOKEN=

# ----------------------------------------------------------------------------
# Admin bootstrap
# ----------------------------------------------------------------------------
# The pre-existing admin account. Created in Clerk dashboard with
# publicMetadata.role = "admin". Signs in via Google (Gmail) or phone.
ADMIN_BOOTSTRAP_EMAIL=admin123@gmail.com

# ----------------------------------------------------------------------------
# Public site URL
# ----------------------------------------------------------------------------
# Used in OG tags, metadata, canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production: NEXT_PUBLIC_SITE_URL=https://sabxi.com
